<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1000" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- Title -->
    <mxCell id="title" value="L2 DFD: 4.0 Job Queue (Import Pipeline)" style="text;fontSize=18;fontStyle=1;align=left;verticalAlign=top;fillColor=none;strokeColor=none;" vertex="1" parent="1">
      <mxGeometry x="40" y="20" width="500" height="30" as="geometry"/>
    </mxCell>

    <!-- External: Asset Import (3.0) -->
    <mxCell id="ext_import" value="3.0&#xa;Asset Import" style="shape=doubleRectangle;rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="260" width="120" height="50" as="geometry"/>
    </mxCell>

    <!-- External: Frontend (1.0) - for polling -->
    <mxCell id="ext_frontend" value="1.0&#xa;Frontend" style="shape=doubleRectangle;rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="700" width="120" height="50" as="geometry"/>
    </mxCell>

    <!-- External: FFmpeg -->
    <mxCell id="ext_ffmpeg" value="FFmpeg&#xa;/ ffprobe" style="shape=doubleRectangle;rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1200" y="260" width="120" height="50" as="geometry"/>
    </mxCell>

    <!-- Processes -->
    <mxCell id="p41" value="4.1&#xa;Enqueue Job" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="260" y="220" width="140" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="p42" value="4.2&#xa;Sequential&#xa;Runner" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="500" y="220" width="140" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="p43" value="4.3&#xa;Probe&#xa;Metadata" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="780" y="100" width="140" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="p44" value="4.4&#xa;Generate&#xa;Thumbnail" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="780" y="260" width="140" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="p45" value="4.5&#xa;Generate Proxy&#xa;/ HEIC Convert" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="780" y="420" width="140" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="p46" value="4.6&#xa;Update Asset&#xa;in project.json" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="500" y="500" width="140" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="p47" value="4.7&#xa;Report Job&#xa;Status" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="260" y="660" width="140" height="90" as="geometry"/>
    </mxCell>

    <!-- Data Stores -->
    <mxCell id="d4" value="D4  Job Store (Memory)" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="260" y="400" width="200" height="36" as="geometry"/>
    </mxCell>

    <mxCell id="d2" value="D2  assets/" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="780" y="600" width="180" height="36" as="geometry"/>
    </mxCell>

    <mxCell id="d3" value="D3  proxies/ + thumbnails/" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="780" y="680" width="220" height="36" as="geometry"/>
    </mxCell>

    <mxCell id="d1" value="D1  project.json" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="500" y="680" width="180" height="36" as="geometry"/>
    </mxCell>

    <!-- Flow: 3.0 to 4.1 (enqueue) -->
    <mxCell id="f1" value="Job { assetId,&#xa;projectId, type: import }" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ext_import" target="p41">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flow: 4.1 to D4 (store job as pending) -->
    <mxCell id="f2" value="store&#xa;{ status: pending }" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;fontSize=11;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="p41" target="d4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="330" y="360"/>
          <mxPoint x="320" y="360"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.1 to 4.2 (trigger runner) -->
    <mxCell id="f3" value="trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p41" target="p42">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flow: 4.2 reads D4 to pick next job -->
    <mxCell id="f4" value="dequeue next pending&#xa;(concurrency=1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;fontSize=11;exitX=0.3;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="p42" target="d4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="542" y="360"/>
          <mxPoint x="400" y="360"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.2 updates D4 to processing -->
    <mxCell id="f4b" value="set processing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;fontSize=11;dashed=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p42" target="d4">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flow: 4.2 to 4.3 (start pipeline: probe) -->
    <mxCell id="f5" value="asset info&#xa;(step 1)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;fontSize=11;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="p42" target="p43">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="700" y="238"/>
          <mxPoint x="700" y="145"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.3 to FFmpeg (ffprobe) -->
    <mxCell id="f6" value="ffprobe -show_format&#xa;-show_streams" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;fontSize=11;exitX=1;exitY=0.3;entryX=0.3;entryY=0;" edge="1" parent="1" source="p43" target="ext_ffmpeg">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1000" y="127"/>
          <mxPoint x="1000" y="80"/>
          <mxPoint x="1236" y="80"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="f6b" value="JSON metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;fontSize=11;dashed=1;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="ext_ffmpeg" target="p43">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1160" y="295"/>
          <mxPoint x="1160" y="200"/>
          <mxPoint x="960" y="200"/>
          <mxPoint x="960" y="163"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.3 to 4.4 (metadata parsed, proceed to thumbnail) -->
    <mxCell id="f7" value="width, height,&#xa;durationMs, codec, ..." style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p43" target="p44">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flow: 4.4 to FFmpeg (thumbnail) -->
    <mxCell id="f8" value="ffmpeg -vframes 1&#xa;-vf scale=640:-1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p44" target="ext_ffmpeg">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flow: 4.4 to D3 (write thumbnail) -->
    <mxCell id="f8b" value="write JPEG" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;fontSize=11;exitX=0.5;exitY=1;entryX=0.3;entryY=0;" edge="1" parent="1" source="p44" target="d3">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="850" y="380"/>
          <mxPoint x="750" y="380"/>
          <mxPoint x="750" y="660"/>
          <mxPoint x="846" y="660"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.4 to 4.5 (proceed to proxy) -->
    <mxCell id="f9" value="(step 3)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;fontSize=11;exitX=0.8;exitY=1;entryX=0.8;entryY=0;" edge="1" parent="1" source="p44" target="p45">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="892" y="390"/>
          <mxPoint x="892" y="390"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.5 to FFmpeg (proxy / HEIC) -->
    <mxCell id="f10" value="ffmpeg -vf scale=1280:-1&#xa;or HEIC to JPEG" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.8;" edge="1" parent="1" source="p45" target="ext_ffmpeg">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1160" y="465"/>
          <mxPoint x="1160" y="302"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.5 progress to D4 -->
    <mxCell id="f10c" value="progress 0.0-1.0&#xa;(stderr parse)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;fontSize=11;exitX=0;exitY=0.8;entryX=1;entryY=0.5;" edge="1" parent="1" source="p45" target="d4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="720" y="490"/>
          <mxPoint x="720" y="560"/>
          <mxPoint x="500" y="560"/>
          <mxPoint x="500" y="418"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.5 to D3 (write proxy) -->
    <mxCell id="f10b" value="write proxy MP4&#xa;or JPEG" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;fontSize=11;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="p45" target="d3">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="850" y="550"/>
          <mxPoint x="934" y="550"/>
          <mxPoint x="934" y="660"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.5 reads from D2 (original asset) -->
    <mxCell id="f_d2_read" value="read original" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontSize=11;exitX=0.3;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p45" target="d2">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="822" y="560"/>
          <mxPoint x="869" y="560"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.5 to 4.6 (pipeline done, update project.json) -->
    <mxCell id="f11" value="thumbnailPath,&#xa;proxyPath,&#xa;metadata" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;fontSize=11;exitX=0;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="p45" target="p46">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="720" y="520"/>
          <mxPoint x="680" y="520"/>
          <mxPoint x="680" y="527"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.6 to D1 (update project.json) -->
    <mxCell id="f12" value="update asset fields&#xa;(proxyPath, thumbnailPath,&#xa;width, height, ...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontSize=11;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p46" target="d1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flow: 4.6 to D4 (mark completed or failed) -->
    <mxCell id="f13" value="set completed&#xa;or failed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;fontSize=11;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p46" target="d4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="240" y="545"/>
          <mxPoint x="240" y="418"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.6 to 4.2 (trigger next job) -->
    <mxCell id="f13b" value="trigger next" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;fontSize=11;dashed=1;exitX=0;exitY=0.2;entryX=0;entryY=0.8;" edge="1" parent="1" source="p46" target="p42">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="480" y="510"/>
          <mxPoint x="480" y="470"/>
          <mxPoint x="210" y="470"/>
          <mxPoint x="210" y="292"/>
          <mxPoint x="500" y="292"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: Frontend polls 4.7 -->
    <mxCell id="f14" value="GET /api/jobs/:id&#xa;(poll 1s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="ext_frontend" target="p47">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flow: 4.7 reads D4 -->
    <mxCell id="f15" value="read status,&#xa;progress, error" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;fontSize=11;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="p47" target="d4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="330" y="600"/>
          <mxPoint x="360" y="600"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flow: 4.7 response to Frontend -->
    <mxCell id="f16" value="Job { status,&#xa;progress, error }" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;fontSize=11;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="p47" target="ext_frontend">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="220" y="732"/>
          <mxPoint x="220" y="740"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Retry flow -->
    <mxCell id="p48" value="4.8&#xa;Retry&#xa;Failed Job" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="260" y="830" width="140" height="90" as="geometry"/>
    </mxCell>

    <mxCell id="f17" value="POST /api/jobs/:id/retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;fontSize=11;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="ext_frontend" target="p48">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="100" y="800"/>
          <mxPoint x="100" y="875"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <mxCell id="f18" value="reset to pending&#xa;+ re-enqueue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=1;" edge="1" parent="1" source="p48" target="d4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="440" y="857"/>
          <mxPoint x="440" y="800"/>
          <mxPoint x="220" y="800"/>
          <mxPoint x="220" y="436"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <mxCell id="f18b" value="trigger runner" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;fontSize=11;dashed=1;exitX=1;exitY=0;entryX=0;entryY=1;" edge="1" parent="1" source="p48" target="p42">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="460" y="840"/>
          <mxPoint x="460" y="800"/>
          <mxPoint x="190" y="800"/>
          <mxPoint x="190" y="310"/>
          <mxPoint x="500" y="310"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Notes -->
    <mxCell id="note1" value="concurrency = 1&#xa;FFmpeg は CPU ヘビーなので&#xa;同時に 1 ジョブのみ実行" style="shape=note;size=14;whiteSpace=wrap;fillColor=#FFF9C4;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
      <mxGeometry x="1060" y="520" width="220" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="note2" value="Pipeline: probe (4.3)&#xa;then thumbnail (4.4)&#xa;then proxy/HEIC (4.5)&#xa;then update (4.6)" style="shape=note;size=14;whiteSpace=wrap;fillColor=#FFF9C4;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
      <mxGeometry x="1060" y="600" width="220" height="70" as="geometry"/>
    </mxCell>

    <mxCell id="note3" value="failed 時: error を Job に&#xa;記録し、retry 可能" style="shape=note;size=14;whiteSpace=wrap;fillColor=#FFF9C4;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1">
      <mxGeometry x="40" y="870" width="200" height="44" as="geometry"/>
    </mxCell>

  </root>
</mxGraphModel>
