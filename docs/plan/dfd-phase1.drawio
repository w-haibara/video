          <mxPoint x="1340" y="460"/>
          <mxPoint x="1080" y="460"/>
          <mxPoint x="1080" y="420"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flows: Job Queue to D1 (update project.json with metadata) -->
    <mxCell id="f16" value="update asset metadata&#xa;(proxyPath, thumbnailPath, ...)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontSize=11;exitX=0.5;exitY=0;entryX=1;entryY=0.5;" edge="1" parent="1" source="p4" target="d1">
