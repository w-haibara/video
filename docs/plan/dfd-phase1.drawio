    <!-- Flows: Media Server to D3 -->
    <mxCell id="f18" value="read" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;fontSize=11;exitX=1;exitY=0.7;entryX=0;entryY=0.5;" edge="1" parent="1" source="p5" target="d3">
