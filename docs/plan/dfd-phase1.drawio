    </mxCell>

    <!-- Flows: Job Queue to D3 (write proxy/thumbnail files) -->
    <mxCell id="f17" value="write proxy / thumbnail" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;fontSize=11;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="p4" target="d3">
      <mxGeometry relative="1" as="geometry">
