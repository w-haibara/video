    <mxCell id="f15" value="metadata / files / exit code" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;fontSize=11;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="ffmpeg" target="p4">
      <mxGeometry relative="1" as="geometry">
