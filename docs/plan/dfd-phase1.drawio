    <mxCell id="f8" value="JPEG / MP4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;fontSize=11;dashed=1;exitX=0;exitY=0.7;entryX=0.3;entryY=1;" edge="1" parent="1" source="p5" target="p1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="348" y="656"/>
          <mxPoint x="348" y="500"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flows: Frontend to Job (polling) -->
    <mxCell id="f9" value="GET /api/jobs/:id&#xa;(poll 1s)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;fontSize=11;exitX=1;exitY=0.2;entryX=0;entryY=0.8;" edge="1" parent="1" source="p1" target="p4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="480" y="360"/>
          <mxPoint x="480" y="260"/>
          <mxPoint x="880" y="260"/>
          <mxPoint x="880" y="420"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flows: Project API to D1 -->
    <mxCell id="f10" value="read / write" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p2" target="d1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flows: Asset Import to D2 -->
    <mxCell id="f11" value="save original file" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;fontSize=11;exitX=0.8;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3" target="d2">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="728" y="480"/>
          <mxPoint x="810" y="480"/>
          <mxPoint x="810" y="560"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flows: Asset Import to Job Queue -->
    <mxCell id="f12" value="enqueue job" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p3" target="p4">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flows: Job Queue to D4 -->
    <mxCell id="f13" value="store / update status" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#9673a6;fontSize=11;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4" target="d4">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1080" y="360"/>
          <mxPoint x="1080" y="250"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flows: Job Queue to FFmpeg -->
    <mxCell id="f14" value="probe / thumbnail&#xa;/ proxy / HEIC convert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#d6b656;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p4" target="ffmpeg">
      <mxGeometry relative="1" as="geometry"/>
