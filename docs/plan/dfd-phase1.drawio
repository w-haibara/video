<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
  <root>
    <mxCell id="0"/>
    <mxCell id="1" parent="0"/>

    <!-- External Entities -->
    <mxCell id="user" value="User&#xa;(Browser)" style="shape=doubleRectangle;rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="40" y="360" width="140" height="60" as="geometry"/>
    </mxCell>

    <mxCell id="ffmpeg" value="FFmpeg&#xa;/ ffprobe" style="shape=doubleRectangle;rounded=0;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="1380" y="360" width="140" height="60" as="geometry"/>
    </mxCell>

    <!-- Processes -->
    <mxCell id="p1" value="1.0&#xa;Frontend&#xa;(React + Vite)" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="300" y="340" width="160" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="p2" value="2.0&#xa;Project API&#xa;(Hono Router)" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="600" y="120" width="160" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="p3" value="3.0&#xa;Asset Import&#xa;(Hono Router)" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="600" y="340" width="160" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="p4" value="4.0&#xa;Job Queue&#xa;(In-Memory)" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="900" y="340" width="160" height="100" as="geometry"/>
    </mxCell>

    <mxCell id="p5" value="5.0&#xa;Media Server&#xa;(Static Files)" style="ellipse;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="600" y="580" width="160" height="100" as="geometry"/>
    </mxCell>

    <!-- Data Stores -->
    <mxCell id="d1" value="D1  project.json" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="840" y="140" width="200" height="40" as="geometry"/>
    </mxCell>

    <mxCell id="d2" value="D2  assets/" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="840" y="540" width="200" height="40" as="geometry"/>
    </mxCell>

    <mxCell id="d3" value="D3  proxies/ + thumbnails/" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="840" y="620" width="200" height="40" as="geometry"/>
    </mxCell>

    <mxCell id="d4" value="D4  Job Store (Memory)" style="shape=partialRectangle;top=0;left=0;right=0;bottom=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=13;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1">
      <mxGeometry x="1100" y="230" width="200" height="40" as="geometry"/>
    </mxCell>

    <!-- Flows: User to Frontend -->
    <mxCell id="f1" value="File select&#xa;+ project ops" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontSize=11;exitX=1;exitY=0.3;entryX=0;entryY=0.4;" edge="1" parent="1" source="user" target="p1">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f2" value="UI render&#xa;(thumbnails, status)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#666666;fontSize=11;exitX=0;exitY=0.6;entryX=1;entryY=0.7;" edge="1" parent="1" source="p1" target="user">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>

    <!-- Flows: Frontend to Project API -->
    <mxCell id="f3" value="POST/GET/PUT/DELETE&#xa;/api/projects" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;fontSize=11;exitX=0.7;exitY=0;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1" target="p2">
