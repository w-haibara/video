    <mxCell id="f4" value="Project JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#6c8ebf;fontSize=11;dashed=1;exitX=0;exitY=0.8;entryX=0.5;entryY=0;" edge="1" parent="1" source="p2" target="p1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="560" y="200"/>
          <mxPoint x="560" y="310"/>
          <mxPoint x="380" y="310"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flows: Frontend to Asset Import -->
    <mxCell id="f5" value="POST /api/assets/import&#xa;(octet-stream)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;fontSize=11;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="p1" target="p3">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="f6" value="{ asset, jobId }" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#82b366;fontSize=11;dashed=1;exitX=0;exitY=0.8;entryX=1;entryY=0.8;" edge="1" parent="1" source="p3" target="p1">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="520" y="420"/>
          <mxPoint x="520" y="420"/>
        </Array>
      </mxGeometry>
    </mxCell>

    <!-- Flows: Frontend to Media Server -->
    <mxCell id="f7" value="GET /media/thumbnails/*&#xa;GET /media/proxies/*" style="edgeStyle=orthogonalEdgeStyle;rounded=1;strokeColor=#b85450;fontSize=11;exitX=0.5;exitY=1;entryX=0;entryY=0.3;" edge="1" parent="1" source="p1" target="p5">
