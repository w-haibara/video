    <!-- Legend -->
    <mxCell id="legend" value="" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=12;swimlaneLine=0;" vertex="1" parent="1">
      <mxGeometry x="1160" y="520" width="280" height="200" as="geometry">
