{
  "name": "Video Editor Dev",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "TZ": "${localEnv:TZ:Asia/Tokyo}",
      "CLAUDE_CODE_VERSION": "latest",
      "GIT_DELTA_VERSION": "0.18.2",
      "ZSH_IN_DOCKER_VERSION": "1.2.1"
    }
  },
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW", "--security-opt=seccomp=unconfined", "-p", "127.0.0.1:5173:5173", "-p", "127.0.0.1:3000:3000", "-p", "127.0.0.1:3001:3001", "-p", "127.0.0.1:6006:6006"],
  "remoteUser": "alice",
  "mounts": [
    "source=video-bashhistory-${devcontainerId},target=/commandhistory,type=volume",
    "source=video-claude-config-${devcontainerId},target=/home/alice/.claude,type=volume",
    "source=${localEnv:USERPROFILE}/.gitconfig,target=/home/alice/.gitconfig,type=bind,readonly",
    "source=video-node-modules-root-${devcontainerId},target=/workspace/node_modules,type=volume",
    "source=video-node-modules-backend-${devcontainerId},target=/workspace/app/backend/node_modules,type=volume",
    "source=video-node-modules-frontend-${devcontainerId},target=/workspace/app/frontend/node_modules,type=volume",
    "source=video-node-modules-shared-${devcontainerId},target=/workspace/app/shared/node_modules,type=volume"
  ],
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CLAUDE_CONFIG_DIR": "/home/alice/.claude",
    "POWERLEVEL9K_DISABLE_GITSTATUS": "true",
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "CHROMIUM_PATH": "/opt/google/chrome/chrome"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "forwardPorts": [5173, 3000, 3001, 6006],
  "portsAttributes": {
    "5173": { "label": "Frontend (Vite)" },
    "3000": { "label": "Backend (Hono)" },
    "3001": { "label": "Feature Catalog" },
    "6006": { "label": "Storybook" }
  },
  "postCreateCommand": "/usr/local/bin/setup-claude.sh && sudo chown alice:alice /workspace/node_modules /workspace/app/backend/node_modules /workspace/app/frontend/node_modules /workspace/app/shared/node_modules && cd /workspace && bun install",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
